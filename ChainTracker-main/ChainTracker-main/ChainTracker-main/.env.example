# Example environment variables for ChainTracker
# Copy this file to `config/.env` (or set real env vars) and replace placeholders.

API_KEY=your_api_key_here

# Preferred model for Gemini-compatible API keys. Change to `gemini:2.5-pro` if needed.
# Examples: gemini:2.5-pro, gemini:2.5, gemini:1.5, gpt-4o
LLM_MODEL=gemini:2.5-pro

# Other optional variables:
# DATABASE_URL=sqlite:///data.db
# DEBUG=true
